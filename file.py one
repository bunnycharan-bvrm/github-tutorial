:root{--bg:#fff8ec;--card:#fff;--ink:#2b1a10;--mut:#7a6556;--acc:#c2410c;--line:#ecd9c0;--ok:#15803d;--bad:#b91c1c}
@media (prefers-color-scheme:dark){:root{--bg:#1c120b;--card:#2a1c12;--ink:#fbeedd;--mut:#c9ae96;--line:#4a3322;--acc:#f97316}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Georgia,'Times New Roman',serif;line-height:1.5}
.w{max-width:1000px;margin:auto;padding:0 18px}
header{background:linear-gradient(135deg,#7c2d12,#c2410c 60%,#f59e0b);color:#fff;padding:56px 0 48px;text-align:center}
header h1{font-size:clamp(2rem,6vw,3.4rem);margin:0}
header p{opacity:.92;margin:8px 0 20px;font-family:system-ui,sans-serif}
.btn{background:var(--acc);color:#fff;border:0;border-radius:10px;padding:12px 20px;font-size:1rem;cursor:pointer;font-family:system-ui,sans-serif}
.btn.alt{background:#fff;color:#7c2d12}
.btn.full{width:100%;margin-top:12px}
.btn:disabled{opacity:.5;cursor:not-allowed}
:focus-visible{outline:3px solid #f59e0b;outline-offset:2px}
section{padding:36px 0}
h2{margin:0 0 16px;font-size:1.8rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}
.dish .pic{height:150px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:4rem;margin-bottom:10px}
.dish h3{margin:0}
.dish p{color:var(--mut);margin:4px 0 10px;font-family:system-ui,sans-serif;font-size:.92rem}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;font-family:system-ui,sans-serif}
.qty button{width:32px;height:32px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font-size:1.1rem;cursor:pointer}
.tables{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:12px}
.t{border:2px solid var(--line);border-radius:14px;padding:12px 6px;text-align:center;cursor:pointer;background:var(--card);color:var(--ink);font-family:system-ui,sans-serif}
.t b{display:block;font-size:1.1rem}
.t small{color:var(--mut)}
.t.taken{background:var(--line);opacity:.55;cursor:not-allowed;text-decoration:line-through}
.t.small{opacity:.45;cursor:not-allowed}
.t.sel{border-color:var(--acc);background:var(--acc);color:#fff}
.t.sel small{color:#ffe}
.leg{display:flex;gap:14px;flex-wrap:wrap;margin:10px 0;font-family:system-ui,sans-serif;font-size:.85rem;color:var(--mut)}
label{display:block;font-family:system-ui,sans-serif;font-size:.85rem;color:var(--mut);margin:10px 0 4px}
input,select{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font-size:1rem}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:620px}
.sum{font-family:system-ui,sans-serif}
.sum div{display:flex;justify-content:space-between;padding:5px 0}
.sum .tot{border-top:1px solid var(--line);font-weight:700;font-size:1.1rem;margin-top:6px;padding-top:10px}
.pay{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
.pay label{display:flex;align-items:center;gap:6px;margin:0;border:1px solid var(--line);border-radius:10px;padding:10px 14px;cursor:pointer;color:var(--ink)}
.pay input{width:auto}
.msg{font-family:system-ui,sans-serif;margin-top:10px;font-size:.92rem}
.note{color:var(--mut)}
.err{color:var(--bad)}
.ok{background:var(--card);border:2px solid var(--ok);border-radius:14px;padding:20px;text-align:center;margin-top:18px}
footer{text-align:center;color:var(--mut);padding:30px 0;font-family:system-ui,sans-serif;font-size:.85rem}
.hide{display:none}
@media(max-width:560px){.two{grid-template-columns:1fr}.three{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}